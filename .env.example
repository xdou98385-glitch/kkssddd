# 必填：Anthropic API key（只放在服务器上，别提交到 git）
ANTHROPIC_API_KEY=

# 站点登录密码。放公网（Funnel）必须设，用 20 位以上的随机串。
# 不设 = 不需要登录，只适合放在 Tailscale 私网里。改密码会让所有已登录设备掉线。
APP_PASSWORD=

# Memos 记忆（两项都填才启用记忆功能）
# 地址：Memos 在这台服务器上的端口，比如 http://127.0.0.1:5230
# Token：Memos 里 设置 → 我的账号 → Access Tokens 生成
MEMOS_URL=
MEMOS_TOKEN=

# 微信读书（Agent Gateway）。填你的 token（形如 wrk-xxxx），不填就没有读书功能
WEREAD_API_KEY=

# 设备事件：iPhone 快捷指令往 /api/events 汇报时用的口令，用 20 位以上的随机串。不填就没有这个功能
# 生成：openssl rand -base64 24
DEVICE_TOKEN=

# 可选
# 主动消息多久「想一次」要不要开口，单位分钟，默认 90
PROACTIVE_EVERY_MIN=90
# 推送服务要求的联系方式，默认随便一个；想填自己的邮箱就写 mailto:你的邮箱
PUSH_CONTACT=
PORT=3000
DB_PATH=data/chat.db
